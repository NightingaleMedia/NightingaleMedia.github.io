{"componentChunkName":"component---src-templates-single-project-tsx","path":"/projects/multi-channel-music-sharing-app","result":{"data":{"project":{"Completed":"a year ago","dateCompleted":"2025-05-15","Title":"Multi-Channel Music Sharing App","RepoLink":"https://github.com/soundcompass","LiveLink":"https://app.silveraudio.io/projects/5b399918-3c48-41a2-a951-30a3738379c3/media/5da3a399-8189-4df0-9f57-f10d237ea60a/versions/8e586c2b-a3f9-4b52-a1e2-835c2878d3cf","skills":[{"skill":{"Link":"https://graphql.org/","Mastery":"Mastered","SkillName":"GraphQL"},"SkillCategory":"backend"},{"skill":{"Link":"https://cloud.google.com/gcp","Mastery":"Mastered","SkillName":"Google Cloud"},"SkillCategory":"other"},{"skill":{"Link":"https://mui.com/material-ui/","Mastery":"Mastered","SkillName":"Material UI"},"SkillCategory":"frontend"},{"skill":{"Link":"https://avatars.githubusercontent.com/u/44036562?s=200&v=4","Mastery":"Mastered","SkillName":"GH Actions"},"SkillCategory":"other"},{"skill":{"Link":"https://en.wikipedia.org/wiki/Bash_(Unix_shell)","Mastery":"Mastered","SkillName":"Bash"},"SkillCategory":"backend"},{"skill":{"Link":"https://socket.io/docs/v4/client-api/","Mastery":"Mastered","SkillName":"Socket IO"},"SkillCategory":"backend"},{"skill":{"Link":"https://playwright.dev/","Mastery":"In Progress","SkillName":"Playwright"},"SkillCategory":"other"},{"skill":{"Link":"https://www.typescriptlang.org/","Mastery":"Mastered","SkillName":"Typescript"},"SkillCategory":"frontend"},{"skill":{"Link":"https://pytorch.org/","Mastery":"To Do","SkillName":"PyTorch"},"SkillCategory":"creative"}],"Narrative":{"data":{"childMarkdownRemark":{"html":"<p>Built for How Audio Is Actually Made\nFrom first upload to final approval, Silver Audio fits into your existing workflow — but better organized and with frame-accurate precision.</p>\n<p>Upload entire projects, not just tracks\nDrop in audio files, stems, artwork, videos, and notes. Everything lives in one organized workspace. No more hunting through Drive folders or expired WeTransfer links.</p>\n<p>Get frame-accurate feedback, not vague comments\nCollaborators click exact moments in your waveform to leave timestamped notes. 'Reduce hi-hat at 1:23' instead of 'drums need work.' See exactly what they mean.</p>\n<p>Organize projects with version history\nTrack every revision. Compare versions side-by-side. See who said what and when. No more 'final_final_v3_REAL.wav' file naming chaos.</p>\n<p>Collaborate with unlimited teammates\nShare private links with your team, clients, and collaborators. They can review and comment without creating an account. No per-seat pricing.</p>\n<p>Review projects anywhere, even on mobile\nSilver Audio works in any browser — desktop, tablet, or phone. Your clients can leave feedback from anywhere. No app download required.</p>\n<p>Guide feedback with context and notes\nUpload instructions, reference tracks, or session notes. Set the tone so collaborators give you the exact kind of feedback you need.</p>"}}},"tags":[{"tagName":"App Development"},{"tagName":"music production"},{"tagName":"project"},{"tagName":"Product Management"}],"Cover":{"alternativeText":"Screenshot 2026-03-25 at 9.32.26 PM.png","localFile":{"url":"https://storage.googleapis.com/sigman-public-assets/Screenshot_2026_03_25_at_9_32_26_PM_1bc75bd668/Screenshot_2026_03_25_at_9_32_26_PM_1bc75bd668.png","childImageSharp":{"gatsbyImageData":{"layout":"fullWidth","backgroundColor":"#e8e8e8","images":{"fallback":{"src":"/static/4126cea4a1f9f901145d81b18731b359/8ede4/Screenshot_2026_03_25_at_9_32_26_PM_1bc75bd668.png","srcSet":"/static/4126cea4a1f9f901145d81b18731b359/bfb05/Screenshot_2026_03_25_at_9_32_26_PM_1bc75bd668.png 750w,\n/static/4126cea4a1f9f901145d81b18731b359/622c1/Screenshot_2026_03_25_at_9_32_26_PM_1bc75bd668.png 1080w,\n/static/4126cea4a1f9f901145d81b18731b359/8ede4/Screenshot_2026_03_25_at_9_32_26_PM_1bc75bd668.png 1104w","sizes":"100vw"},"sources":[{"srcSet":"/static/4126cea4a1f9f901145d81b18731b359/