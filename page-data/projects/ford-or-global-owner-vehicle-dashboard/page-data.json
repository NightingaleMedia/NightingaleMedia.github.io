{"componentChunkName":"component---src-templates-single-project-tsx","path":"/projects/ford-or-global-owner-vehicle-dashboard","result":{"data":{"project":{"Completed":"7 months ago","dateCompleted":"2025-09-01","Title":"Ford | Global Owner Vehicle Dashboard","RepoLink":null,"LiveLink":"https://www.ford.com/support","skills":[{"skill":{"Link":"https://reactjs.org/","Mastery":"Mastered","SkillName":"React"},"SkillCategory":"frontend"},{"skill":{"Link":"https://nextjs.org/","Mastery":"Mastered","SkillName":"NextJS"},"SkillCategory":"frontend"},{"skill":{"Link":"https://expressjs.com/","Mastery":"Mastered","SkillName":"Express.js"},"SkillCategory":"backend"},{"skill":{"Link":"https://nodejs.org/en/about/","Mastery":"Mastered","SkillName":"Node.js"},"SkillCategory":"backend"},{"skill":{"Link":"https://graphql.org/","Mastery":"Mastered","SkillName":"GraphQL"},"SkillCategory":"backend"},{"skill":{"Link":"https://tailwindcss.com/","Mastery":"In Progress","SkillName":"Tailwind CSS"},"SkillCategory":"frontend"}],"Narrative":{"data":{"childMarkdownRemark":{"html":"<p>Vehicle dashboard is a global ford product that is a Ford owner's first start into the ownership experience.  Here users can check the status of their vehicle, get help with service appointments, receive critical updates about recalls and vehicle health and gain trust with Ford on their ownership journey.</p>\n<p>We built this product from the ground up as part of a company-wide redesign of our systems technology stack.  I was put as a senior engineer of the tiger team that had an aggressive deadline to re-write the entire product in next.js using the latest and greatest web technologies.</p>\n<p>This page involved a huge amount of integration with dozens of company systems like vehicle telemetry, recalls databases, vehicle health information, dealership data and user information.  The APIs ranged from graphql, REST, SOAP, bigquery and postgres databases directly.</p>\n<p>Stitched together the experience is seamless and we already have had millions of monthly views.</p>"}}},"tags":[{"tagName":"Product Management"},{"tagName":"UI / UX"},{"tagName":"project"}],"Cover":{"alternativeText":"vehicle-dashboard-out.gif","localFile":{"url":"https://storage.googleapis.com/sigman-public-assets/vehicle_dashboard_out_70e9f5a73c/vehicle_dashboard_out_70e9f5a73c.gif","childImageSharp":null}},"Gallery":[{"localFile":{"childImageSharp":{"gatsbyImageData":{"layout":"fullWidth","backgroundColor":"#f8f8f8","images":{"fallback":{"src":"/static/358b90133957a77d4375bb4f2f8305b7/5182c/Screenshot_2026_03_25_at_9_09_21_PM_7bbade6f06.png","srcSet":"/static/358b90133957a77d4375bb4f2f8305b7/1f417/Screenshot_2026_03_25_at_9_09_21_PM_7bbade6f06.png 750w,\n/static/358b90133957a77d4375bb4f2f8305b7/21560/Screenshot_2026_03_25_at_9_09_21_PM_7bbade6f06.png 1080w,\n/static/358b90133957a77d4375bb4f2f8305b7/ecb11/Screenshot_2026_03_25_at_9_09_21_PM_7bbade6f06.png 1366w,\n/static/358b90133957a77d4375bb4f2f8305b7/5182c/Screenshot_2026_03_25_at_9_09_21_PM_7bbade6f06.png 1396w","sizes":"100vw"},"sources":[{"srcSet":"/static/358b90133957a77d4375bb4f2f8305b7/ca3a2/Screenshot_2026_03_25_at_9_09_21_PM_7bbade6f06.webp 750w,\n/static/358b90133957a77d4375bb4f2f8305b7/7b075/Screenshot_2026_03_25_at_9_09_21_PM_7bbade6f06.webp 1080w,\n/static/358b90133957a77d4375bb4f2f8305b7/00ddf/Screenshot_2026_03_25_at_9_09_21_PM_7bbade6f06.webp 1366w,\n/static/358b90133957a77d4375bb4f2f8305b7/255a6/Screenshot_2026_03_25_at_9_09_21_PM_7bbade6f06.webp 1396w","type":"image/webp","sizes":"100vw"}]},"width":1,"height":0.7872492836676218},"fixed":{"base64":"data:image/png;base64,","width":400,"height":315,"src":"/static/358b90133957a77d4375bb4f2f8305b7/497c6/Screenshot_2026_03_25_at_9_09_21_PM_7bbade6f06.png","srcSet":"/static/358b90133957a77d4375bb4f2f8305b7/497c6/Screenshot_2026_03_25_at_9_09_21_PM_7bbade6f06.png 1x,\n/static/358b90133957a77d4375bb4f2f8305b7/2a4de/Screenshot_2026_03_25_at_9_09_21_PM_7bbade6f06.png 1.5x,\n/static/358b90133957a